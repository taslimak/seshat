SESHAT_ENV=development
SESHAT_MODEL_PATH=artifacts/model.joblib
SESHAT_LOG_LEVEL=INFO

# Provider API keys: only needed for live collection
#   seshat-data collect --execute-live --max-cost-usd N
# Copy to .env (gitignored) and fill in locally. Never commit real values.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# GOOGLE_API_KEY= (alternative to GEMINI_API_KEY)

# Secret for HMAC-SHA256 prompt hashing. Set it before collecting real data.
SESHAT_PROMPT_HASH_KEY=

# Set to 1 to run the gated live adapter tests (each also needs its API key).
SESHAT_LIVE_TESTS=0
