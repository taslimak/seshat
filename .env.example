SESHAT_ENV=development
SESHAT_MODEL_PATH=artifacts/model.joblib
SESHAT_LOG_LEVEL=INFO

# Controlled experiment providers. Never commit real values.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Real provider calls are refused unless this is 1 (or --allow-provider-calls is passed).
SESHAT_ALLOW_PROVIDER_CALLS=0
# Secret for HMAC-SHA256 prompt hashing. Set in production; never commit a real value.
SESHAT_PROMPT_HASH_KEY=
