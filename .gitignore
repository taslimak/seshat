# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Environments
.venv/
venv/
.env

# Model/data artifacts. Collected datasets never go into Git by default;
# only data/README.md and the small mock-only data/fixtures/ are tracked.
artifacts/*
!artifacts/README.md
data/*
!data/README.md
!data/fixtures/
*.joblib
*.pkl
*.parquet
!tests/**/*.parquet

# Editors / OS
.DS_Store
.vscode/
.idea/
